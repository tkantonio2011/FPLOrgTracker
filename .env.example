# =============================================================================
# FPL Tracker — environment variables
# Copy to .env.local (or .env) and fill in. Do not commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite via Prisma. Use a relative path for local dev, absolute for production.
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Optional overrides; defaults are sensible for production.
# SESSION_COOKIE_NAME="session"
# SESSION_TTL_DAYS="30"

# -----------------------------------------------------------------------------
# Auth bootstrap (required in production)
# -----------------------------------------------------------------------------
# Email of the platform Super Admin. Comma-separate to bootstrap multiple.
# Read on every boot; idempotent — adds-or-keeps, never removes.
BOOTSTRAP_SUPER_ADMIN_EMAIL=""

# Used by the 002 migration only. Set this BEFORE running `npm run db:seed`
# against an existing single-tenant deployment. The user with this email becomes
# the initial League Admin of the migrated league.
BOOTSTRAP_LEAGUE_ADMIN_EMAIL=""

# -----------------------------------------------------------------------------
# SMTP (required in production — magic-link is the only sign-in mechanism)
# -----------------------------------------------------------------------------
# When SMTP_HOST is unset, the app falls back to logging magic-links to the
# server console with a "DEV MODE — magic link" prefix. Useful for local dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FPL Tracker <noreply@example.com>"

# -----------------------------------------------------------------------------
# LLM (existing — narrative / horoscope / gw-report / trash-talk / tribunal)
# -----------------------------------------------------------------------------
GROQ_API_KEY=""
