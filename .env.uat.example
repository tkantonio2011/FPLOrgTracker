# =============================================================================
# UAT environment — DO NOT use in production.
# Copy this file to .env.uat (which is gitignored) and fill in real values.
# scripts/uat/deploy.sh uploads .env.uat to the UAT EC2 instance as .env.local.
#
# Contract: specs/004-uat-deployment/contracts/env-vars.md
# Runbook:  specs/004-uat-deployment/quickstart.md
# =============================================================================

# -----------------------------------------------------------------------------
# Environment identity (REQUIRED)
# -----------------------------------------------------------------------------
# Tri-state — production | uat | development. Anything else throws at startup.
APP_ENV=uat
PORT=3000

# Public URL of the UAT instance. MUST be different from production APP_URL.
# Per the spec clarification, UAT is served at a raw Elastic IP (no DNS, no TLS).
# Set this to the value of `terraform output uat_public_ip`.
APP_URL=http://<UAT-ELASTIC-IP>/

# -----------------------------------------------------------------------------
# Database (REQUIRED) — separate SQLite file on the UAT host
# -----------------------------------------------------------------------------
DATABASE_URL="file:/home/ec2-user/app/prisma/uat.db"

# -----------------------------------------------------------------------------
# UAT allow-list (REQUIRED — at least one address)
# -----------------------------------------------------------------------------
# Comma-separated tester emails. Whitespace is trimmed; matching is case-insensitive.
# An empty value or trailing comma will refuse to start the server.
# This is the sole control on who can sign in to UAT — see spec FR-009.
UAT_ALLOWED_EMAILS=""

# -----------------------------------------------------------------------------
# Auth bootstrap (REQUIRED)
# -----------------------------------------------------------------------------
# Email of the UAT Super Admin. MUST differ from production BOOTSTRAP_SUPER_ADMIN_EMAIL
# so a leak of one address does not compromise the other environment.
# Per the spec FR-022, this becomes the *only* Super Admin after every refresh-from-prod.
BOOTSTRAP_SUPER_ADMIN_EMAIL=""

# -----------------------------------------------------------------------------
# Session secret (REQUIRED)
# -----------------------------------------------------------------------------
# Generate fresh: openssl rand -base64 48
# MUST differ from production SESSION_SECRET.
SESSION_SECRET=""

# Cookies stay non-secure while UAT is served over HTTP.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# SMTP (shared with production — per spec clarification Q3)
# -----------------------------------------------------------------------------
# UAT reuses production's outbound email lane verbatim. The allow-list (FR-009)
# is the sole control preventing UAT email from reaching real production members.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# -----------------------------------------------------------------------------
# LLM (shared with production — used by GW reports, narrative, tribunal)
# -----------------------------------------------------------------------------
GROQ_API_KEY=""
